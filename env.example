# Loreley configuration example
#
# Copy this file to `.env` and adjust values for your environment:
#
#   cp env.example .env
#
# Notes:
# - This file is loaded by `loreley.config.Settings` via pydantic-settings.
# - Complex types (lists/dicts) should be provided as JSON literals.

# -----------------------------------------------------------------------------
# Core application
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Optional: preset profile that applies scaling-oriented defaults.
# Supported values:
# - default
# - large-repo-1m-30k
#
# The profile only overrides settings that are NOT explicitly set via environment
# variables. Required settings (e.g. EXPERIMENT_ID, MAPELITES_EXPERIMENT_ROOT_COMMIT,
# SCHEDULER_MAX_TOTAL_JOBS, WORKER_EVALUATOR_PLUGIN) remain required.
# LORELEY_PROFILE=default

# Optional: override where long-running process logs are written.
# LOGS_BASE_DIR=

# Generate API bearer tokens with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use different values for the UI write token and the agent token.
#
# Required for /api/v1/agent/* bearer-token auth.
# LORELEY_AGENT_API_TOKEN=

# Required for UI API POST routes (operator baseline ensure, job retry, legacy
# repair candidate actions, and deprecated repair schedule-one compatibility
# route). The Streamlit UI sends this token on POST requests when configured in
# its environment.
# LORELEY_API_WRITE_TOKEN=

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# If you use `docker-compose.yml` in this repo, keep these defaults.
# One database is used per experiment (single-tenant). New databases are initialized
# automatically on API/scheduler/worker startup when DB_AUTO_MIGRATE=true, or
# explicitly with `uv run loreley db migrate`.
DATABASE_URL=postgresql+psycopg://loreley:loreley@localhost:5432/loreley
# Schema upgrades from v0.7.9-alpha schema version 5 to the current version are
# native and data-preserving. Set DB_AUTO_MIGRATE=false if fresh initialization
# and upgrades must use an explicit `uv run loreley db migrate` step before
# API/scheduler/worker startup.
DB_AUTO_MIGRATE=true
DB_MIGRATION_LOCK_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Task queue / Dramatiq broker (Redis)
# -----------------------------------------------------------------------------
TASKS_REDIS_URL=redis://127.0.0.1:6379/0
# Loreley derives both the Redis broker namespace and the Dramatiq queue name
# from EXPERIMENT_ID so multiple experiments can share a Redis instance safely.

# -----------------------------------------------------------------------------
# Scheduler
# -----------------------------------------------------------------------------
# Path to a git checkout of the TARGET repository that the scheduler monitors.
# If unset, the scheduler falls back to WORKER_REPO_WORKTREE or the current directory.
# When it shares WORKER_REPO_WORKTREE, scheduler git mutations coordinate with the
# worker via the same cross-process repo lock.
SCHEDULER_REPO_ROOT=

# Required: total number of jobs to create before the scheduler stops and
# updates the primary-objective branch deliverable.
SCHEDULER_MAX_TOTAL_JOBS=

# Startup approval: before entering the main loop, the scheduler scans the experiment
# root commit (MAPELITES_EXPERIMENT_ROOT_COMMIT), prints the eligible repo-state file
# count + filter knobs, and asks for an interactive y/n confirmation.
# This requires stdin to be a TTY; in non-interactive environments the scheduler exits.
#
# You can bypass the prompt with either:
# - `--yes` (CLI flag), or
# - `SCHEDULER_STARTUP_APPROVE=true` (environment variable).
# SCHEDULER_STARTUP_APPROVE=false

# Crash recovery: reclaim RUNNING jobs that stopped heartbeating after their lease
# expires. Reclaimed jobs are requeued until the recovery budget is exhausted, then
# marked FAILED.
# SCHEDULER_STALE_RUNNING_RECLAIM_BATCH_SIZE=32
# SCHEDULER_STALE_RUNNING_MAX_RECOVERY_ATTEMPTS=3

# Optional campaign program contract. When `loreley.program.md` exists at the
# target repository root, the scheduler parses it at startup, stores its hash,
# and projects its goal/constraints/scope into jobs. Default locked mode keeps
# using the startup hash if the file changes during a run.
# CAMPAIGN_PROGRAM_CHANGE_POLICY=locked

# Baseline-first comparability (ADR 0050). Production scheduler runs require a
# valid root evaluator baseline before dispatching or scheduling mutation jobs.
# Use "warn" only for local experiments/backfills that may proceed with a
# degraded baseline marker.
# BASELINE_BOOTSTRAP_POLICY=required

# Failed-candidate repair pool (ADR 0048). Deprecated. New repair jobs are no
# longer scheduled; evaluator-guided in-loop rework is the replacement path.
# These settings are retained only for legacy data and compatibility. Older
# schema-version-5 databases migrate with:
#   uv run loreley db migrate
# FAILED_CANDIDATE_REPAIR_ENABLED=false
# FAILED_CANDIDATE_REPAIR_MODE=rebase_from_nearest_viable
# FAILED_CANDIDATE_REPAIR_MAX_ATTEMPTS=1
# FAILED_CANDIDATE_REPAIR_NORMAL_JOBS_PER_TOKEN=9
# FAILED_CANDIDATE_REPAIR_MAX_TOKENS=3
# FAILED_CANDIDATE_REPAIR_MAX_ACTIVE_JOBS=1
# FAILED_CANDIDATE_REPAIR_MAX_JOBS_PER_TICK=1
# FAILED_CANDIDATE_REPAIR_FAILURE_KINDS=validation_failed,test_failed,typecheck_failed,lint_failed
# FAILED_CANDIDATE_REPAIR_AGENT_FEEDBACK_MODE=diagnostic_capsule
# Deprecated: FAILED_CANDIDATE_REPAIR_MAX_DEPTH is retained for compatibility,
# but MVP scheduling only repairs original failed candidates at failed_depth=0.
# FAILED_CANDIDATE_REPAIR_MAX_DIFF_BYTES=65536
# FAILED_CANDIDATE_REPAIR_MAX_DIAGNOSTIC_BYTES=16384

# -----------------------------------------------------------------------------
# Worker repository
# -----------------------------------------------------------------------------
# Attach this worker process (and the scheduler) to a single experiment id.
# The value can be either a UUID or a short human-friendly slug (e.g. "demo-jan21").
# Loreley maps slugs to stable UUIDs internally (uuid5) and derives all queue/path
# names from the same EXPERIMENT_ID value.
# EXPERIMENT_ID must match the database instance marker (seeded on first startup
# when DB_AUTO_MIGRATE=true, or explicitly via `uv run loreley db migrate`).
EXPERIMENT_ID=
# Upstream git remote URL used by workers to clone/fetch/push job branches.
# For local demos you can point this to a local bare repo path (e.g. /abs/path/remote.git).
WORKER_REPO_REMOTE_URL=
WORKER_REPO_BRANCH=main

# Base clone path used by the worker. Each evolution job runs in its own
# isolated git worktree under "<WORKER_REPO_WORKTREE>-worktrees/" and the worker
# removes that per-job worktree after the job completes.
WORKER_REPO_WORKTREE=~/.cache/loreley/worker-repo

# Optional: isolate the base clone per worker process by randomising the final
# path segment of WORKER_REPO_WORKTREE (useful when sharing a filesystem is
# undesirable). When enabled, a process ID plus a suffix like
# "-pid-12345-a1b2c3d4" is appended.
# WORKER_REPO_WORKTREE_RANDOMIZE=false
# WORKER_REPO_WORKTREE_RANDOM_SUFFIX_LEN=8

# Job lease / heartbeat: long-running planning, coding, and evaluation stages renew
# the lease in the background. The scheduler only reclaims RUNNING jobs after the
# lease expires, so long jobs remain safe as long as heartbeats continue.
# WORKER_JOB_LEASE_TTL_SECONDS=1800
# WORKER_JOB_HEARTBEAT_INTERVAL_SECONDS=60

# -----------------------------------------------------------------------------
# Planning / coding backends
# -----------------------------------------------------------------------------
# By default Loreley uses the Kilocode CLI backend (requires `kilo` on PATH).
# You can override the backends using dotted references:
#   WORKER_PLANNING_BACKEND=some.module:backend_factory
#   WORKER_CODING_BACKEND=some.module:backend_factory
#
# Kilocode (default):
# WORKER_KILOCODE_BIN=kilo
# WORKER_KILOCODE_AGENT=
# WORKER_KILOCODE_MODE=  # legacy alias for WORKER_KILOCODE_AGENT
# WORKER_KILOCODE_JSON_OUTPUT=true
# WORKER_KILOCODE_USAGE_DB_PATH=
#
# Optional: when using an OpenAI-compatible gateway with Kilocode, ask Loreley to
# build isolated Kilo provider config for each spawned subprocess. `auto` and
# `config` use KILO_CONFIG_CONTENT with env references so API keys are not
# written into config JSON; `legacy_env` preserves older KILO_OPENAI_* injection;
# `none` relies entirely on Kilo's persisted auth/config.
# WORKER_KILOCODE_PROVIDER_CONFIG_MODE=auto  # auto | config | legacy_env | none
# WORKER_KILOCODE_OPENAI_API_KEY=
# WORKER_KILOCODE_OPENAI_BASE_URL=
# WORKER_KILOCODE_OPENAI_MODEL=
# WORKER_KILOCODE_OPENAI_API_SPEC=responses  # or chat_completions
#
# Codex CLI (optional):
# WORKER_PLANNING_BACKEND=loreley.core.worker.agent.backends.codex_cli:codex_planning_backend
# WORKER_CODING_BACKEND=loreley.core.worker.agent.backends.codex_cli:codex_coding_backend
# WORKER_PLANNING_CODEX_BIN=codex
# WORKER_CODING_CODEX_BIN=codex
# WORKER_PLANNING_CODEX_PROFILE=
# WORKER_CODING_CODEX_PROFILE=
#
# Cursor Agent CLI (optional):
# WORKER_PLANNING_BACKEND=loreley.core.worker.agent.backends.cursor_cli:cursor_planning_backend
# WORKER_CODING_BACKEND=loreley.core.worker.agent.backends.cursor_cli:cursor_coding_backend
# WORKER_CURSOR_MODEL=gpt-5.2-high
# WORKER_CURSOR_FORCE=true

# -----------------------------------------------------------------------------
# Evaluator (required for the worker)
# -----------------------------------------------------------------------------
# Dotted reference to a callable plugin returning `EvaluationResult` or a dict.
# Optional python paths are applied before importing the plugin.
#
# Circle-packing example:
#   WORKER_EVALUATOR_PYTHON_PATHS=["examples/circle_packing_env"]
#   WORKER_EVALUATOR_PLUGIN=evaluate:plugin
WORKER_EVALUATOR_PYTHON_PATHS=[]
WORKER_EVALUATOR_PLUGIN=
# Optional: explicit evaluator identity for campaign baseline keys. When unset,
# Loreley uses a best-effort package version or source fingerprint for
# WORKER_EVALUATOR_PLUGIN. Set this when benchmark data or scoring semantics
# change without changing the plugin source.
# WORKER_EVALUATOR_VERSION=

# Evaluator-guided in-loop rework. When an evaluator returns EvalFail for an
# allowlisted candidate-owned failure, the same worker job can run one bounded
# extra coding pass before publishing any candidate.
# WORKER_EVALUATOR_REWORK_ENABLED=true
# WORKER_EVALUATOR_REWORK_MAX_ATTEMPTS=1
# WORKER_EVALUATOR_REWORK_FAILURE_KINDS=compile,typecheck,lint,test,validation
# WORKER_EVALUATOR_REWORK_MAX_SECONDS=1800

# Optional evaluator-declared artifacts. Evaluators may return bounded artifacts
# with visibility=agent_visible|human_only|hidden. Loreley stores allowed payloads
# under the worker artifact directory, stores metadata in PostgreSQL, and exposes
# non-hidden records through the UI API. Agent feedback includes only
# agent_visible artifacts.
# WORKER_EVALUATION_ARTIFACTS_ENABLED=true
# WORKER_EVALUATION_AGENT_FEEDBACK_MODE=summary  # disabled, manifest, summary, or path
# WORKER_EVALUATION_AGENT_FEEDBACK_MAX_ARTIFACTS=4
# WORKER_EVALUATION_AGENT_FEEDBACK_MAX_DIAGNOSTICS=3
# WORKER_EVALUATION_AGENT_FEEDBACK_MAX_CHARS=2000
# WORKER_EVALUATION_ARTIFACT_MAX_BYTES=10485760
# WORKER_EVALUATION_ARTIFACT_AGENT_PATH_MAX_BYTES=1048576
# WORKER_EVALUATION_ARTIFACT_ALLOWED_MIME_TYPES=["text/plain","application/json","image/svg+xml","image/png","text/html","application/octet-stream"]
# WORKER_EVALUATION_ARTIFACT_AGENT_PATH_MIME_TYPES=["text/plain","application/json","image/svg+xml","text/html"]

# -----------------------------------------------------------------------------
# OpenAI-compatible API (required for embeddings and some summaries)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_API_SPEC=responses
# LLM_USAGE_TRACKING_ENABLED=true
# LLM_USAGE_PRICING_PATH=
# LLM_USAGE_PRICING_JSON=
#
# Optional: dynamically obtain short-lived API keys from a user-provided Python
# callable. The provider must be importable via `module:attr` or `module.attr`
# and return a non-empty token string.
# When enabled:
# - Loreley uses a shared cached token for internal SDK calls and refreshes it
#   before expiry.
# - Kilocode planning/coding subprocesses fetch a fresh one-shot token at
#   subprocess start; Loreley does NOT rotate credentials inside an already
#   running agent process.
# OPENAI_DYNAMIC_API_KEY_PROVIDER=
# OPENAI_DYNAMIC_API_KEY_TTL_SECONDS=
# OPENAI_DYNAMIC_API_KEY_REFRESH_SKEW_SECONDS=

# -----------------------------------------------------------------------------
# Commit summaries
# -----------------------------------------------------------------------------
# The evolution worker uses this helper to generate candidate commit subjects.
# By default it follows the configured Kilocode OpenAI-compatible provider when
# one is available. Use `global_openai` to keep the old global OPENAI_* behavior,
# `custom` for an independent provider, or `disabled` to always use the
# non-LLM fallback subject.
# WORKER_EVOLUTION_COMMIT_PROVIDER_MODE=inherit_worker  # inherit_worker | global_openai | custom | disabled
# WORKER_EVOLUTION_COMMIT_API_KEY=
# WORKER_EVOLUTION_COMMIT_BASE_URL=
# WORKER_EVOLUTION_COMMIT_API_SPEC=responses  # or chat_completions
# WORKER_EVOLUTION_COMMIT_MODEL=gpt-4.1-mini
# WORKER_EVOLUTION_COMMIT_TEMPERATURE=0.2
# WORKER_EVOLUTION_COMMIT_MAX_OUTPUT_TOKENS=128
# WORKER_EVOLUTION_COMMIT_MAX_RETRIES=3
# WORKER_EVOLUTION_COMMIT_RETRY_BACKOFF_SECONDS=2.0
# WORKER_EVOLUTION_COMMIT_SUBJECT_MAX_CHARS=72

# -----------------------------------------------------------------------------
# MAP-Elites (experiment behaviour)
# -----------------------------------------------------------------------------
# Required: pins the experiment root commit used for repo-state bootstrap and
# incremental-only ingestion, and for database instance marker validation.
MAPELITES_EXPERIMENT_ROOT_COMMIT=

# Fixed output dimensionality for code embeddings.
# In the env-only settings model, set this via environment variables and keep it
# consistent across scheduler/worker/UI processes for a given database.
MAPELITES_CODE_EMBEDDING_DIMENSIONS=1536

# Ordered optimization contract. Evaluator results must include every named
# metric with the matching direction. The first objective is used only for
# operational status, root-baseline comparison, and the convenience branch.
MAPELITES_OBJECTIVES=[{"name":"composite_score","direction":"max"}]

# Independent search populations. The first island is the default for commands
# that omit --island-id. Seed/normal scheduling is fair across all entries.
MAPELITES_ISLANDS=["main"]

# Maximum retained non-dominated candidates in one behaviour cell and
# cross-island migration cadence (normal scheduled jobs).
MAPELITES_PARETO_FRONT_MAX_SIZE=8
MAPELITES_PARETO_EPSILON=1e-9
MAPELITES_MIGRATION_INTERVAL_JOBS=50

# Repo-state embedding filters for pathological cleaned inputs. These only
# affect repository-state file embeddings and are included in the embedding
# cache manifest fingerprint.
# MAPELITES_REPO_STATE_EMBEDDING_MAX_LINE_CHARS=16000
# MAPELITES_REPO_STATE_EMBEDDING_MAX_CHUNK_CHARS=65536
